# Copy this file to .env only when you need non-default values.
# The defaults work when all three services run on the same Windows or Linux machine.

# Public web interface (the only port that needs LAN access)
SECURITY_FRONTEND_HOST=0.0.0.0
SECURITY_FRONTEND_PORT=3000

# Private services. Keep these on loopback unless deploying them separately.
SECURITY_GATEWAY_HOST=127.0.0.1
SECURITY_GATEWAY_PORT=8081
ANALYSIS_ENGINE_HOST=127.0.0.1
ANALYSIS_ENGINE_PORT=8082

# Optional comma-separated extra browser origins. Current LAN addresses are added automatically.
SECURITY_ALLOWED_ORIGINS=

# Set to true only when the launcher has Administrator/root privileges and should create a LAN firewall rule.
SECURITY_CONFIGURE_FIREWALL=false

# auto uses the bundled npm cache when present; true forbids network installs; false uses npm registry.
SECURITY_OFFLINE_MODE=auto

# Optional first-run administrator. These values are ignored after storage/security_auth.json exists.
# SECURITY_USERNAME=admin
# SECURITY_PASSWORD=replace-with-a-strong-password

# Optional report preview override. Usually detected automatically on both operating systems.
# Windows example: C:\Program Files\LibreOffice\program\soffice.com
# Ubuntu example: /usr/bin/libreoffice
LIBREOFFICE_PATH=

# Optional external services. They can also be managed from the platform settings page.
OLLAMA_ENABLED=auto
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b
OLLAMA_FALLBACK_MODEL=gpt-oss:20b

# Optional source credentials. Never commit a real .env file.
VIRUSTOTAL_API_KEYS=
ABUSEIPDB_API_KEY=
MALWAREBAZAAR_AUTH_KEY=
