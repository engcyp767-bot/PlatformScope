# Platform Scope — Next.js 16 Web Dashboard Dockerfile
FROM node:20-alpine

WORKDIR /app

# Copy package descriptors
COPY frontend/package*.json ./

# Install dependencies
RUN npm install

# Copy application source
COPY frontend/ ./

# Build production bundle
RUN npm run build

EXPOSE 3000

ENV PORT=3000
ENV NODE_ENV=production

CMD ["npm", "start"]
