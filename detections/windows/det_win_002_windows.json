    "tactics": [
      "Credential Access"
    ],
    "techniques": [
      "T1110 - Brute Force",
      "T1110.001 - Password Guessing"
    ]
  },
  "condition": {
    "and": [
      {
        "field": "event_id",
        "operator": "eq",
        "value": "4625"
      },
      {
        "field": "action",
        "operator": "in",
        "value": [
          "block",
          "failure",
          "failed",
          "0x1"
        ]
      }
    ]
  },
  "incident_policy": {
    "auto_promote": true,
    "threshold": 3,
    "time_window_seconds": 120,
    "min_confidence": 80,
    "group_by": [
      "username",
      "src_ip"
    ]
  },
